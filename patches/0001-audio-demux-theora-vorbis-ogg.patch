 #include "string_compat.h"
 #include "stb_ds.h"
 
+typedef struct {
+    const AudioEntry* entry;
+    uint8_t* data;
+    uint32_t size;
+} DemuxedAudio;
+
+static DemuxedAudio* demuxedAudioCache = nullptr;
+
+static bool oggReadPage(const uint8_t* data, uint32_t size, uint32_t pos, uint32_t* pageSize, uint32_t* serial, bool* isVorbisStart) {
+    if (pos + 27 > size || memcmp(data + pos, "OggS", 4) != 0) return false;
+
+    uint32_t segmentCount = data[pos + 26];
+    if (pos + 27 + segmentCount > size) return false;
+
+    uint32_t bodySize = 0;
+    repeat(segmentCount, i) bodySize += data[pos + 27 + i];
+
+    *pageSize = 27 + segmentCount + bodySize;
+    if (pos + *pageSize > size) return false;
+
+    memcpy(serial, data + pos + 14, sizeof(*serial));
+    bool isFirstPage = (data[pos + 5] & 0x02) != 0;
+    *isVorbisStart = isFirstPage && bodySize >= 7 && memcmp(data + pos + 27 + segmentCount, "\x01vorbis", 7) == 0;
+    return true;
+}
+
+static uint8_t* oggKeepVorbisOnly(const uint8_t* data, uint32_t size, uint32_t* outSize) {
+    uint32_t pos = 0, pageSize, serial;
+    bool isVorbisStart;
+
+    uint32_t vorbisSerial = 0;
+    bool foundVorbis = false;
+    while (!foundVorbis && oggReadPage(data, size, pos, &pageSize, &serial, &isVorbisStart)) {
+        if (isVorbisStart) {
+            vorbisSerial = serial;
+            foundVorbis = true;
+        }
+        pos += pageSize;
+    }
+    if (!foundVorbis) return nullptr;
+
+    uint32_t keptSize = 0;
+    for (pos = 0; oggReadPage(data, size, pos, &pageSize, &serial, &isVorbisStart); pos += pageSize) {
+        if (serial == vorbisSerial) keptSize += pageSize;
+    }
+    if (keptSize == 0 || keptSize == size) return nullptr;
+
+    uint8_t* kept = (uint8_t*) safeMalloc(keptSize);
+    uint32_t writePos = 0;
+    for (pos = 0; oggReadPage(data, size, pos, &pageSize, &serial, &isVorbisStart); pos += pageSize) {
+        if (serial != vorbisSerial) continue;
+        memcpy(kept + writePos, data + pos, pageSize);
+        writePos += pageSize;
+    }
+
+    *outSize = keptSize;
+    return kept;
+}
+
+static const uint8_t* getDecodableAudio(const AudioEntry* entry, uint32_t* size) {
+    *size = entry->dataSize;
+    if (entry->data == nullptr) return nullptr;
+
+    repeat(arrlen(demuxedAudioCache), i) {
+        DemuxedAudio* cached = &demuxedAudioCache[i];
+        if (cached->entry != entry) continue;
+        if (cached->data == nullptr) return entry->data;
+        *size = cached->size;
+        return cached->data;
+    }
+
+    DemuxedAudio cached = { entry, nullptr, 0 };
+    cached.data = oggKeepVorbisOnly(entry->data, entry->dataSize, &cached.size);
+    arrput(demuxedAudioCache, cached);
+    if (cached.data == nullptr) return entry->data;
+
+    *size = cached.size;
+    return cached.data;
+}
