@@ -77,10 +77,31 @@ static void unmapFile(uint8_t *ptr, size_t size) {
 
 // Reads a uint32 absolute file offset, resolves it into the pre-loaded STRG buffer,
 // and returns a pointer to the null-terminated string content at that offset.
+static const char* readStringOutsideStrg(BinaryReader* reader, DataWin* dw, uint32_t offset) {
+    if (dw->mappedFile) return (const char*) (dw->mappedFile + offset);
+
+    bool inBuffer = reader->buffer != nullptr && offset >= reader->bufferBase && offset - reader->bufferBase < reader->bufferSize;
+    if (!inBuffer) {
+        logError("String pointer 0x%X points outside the STRG chunk and outside the loaded data\n", offset);
+        return "";
+    }
+
+    const char* source = (const char*) (reader->buffer + (offset - reader->bufferBase));
+    size_t length = strnlen(source, reader->bufferSize - (offset - reader->bufferBase));
+    char* copy = (char*) safeMalloc(length + 1);
+    memcpy(copy, source, length);
+    copy[length] = '\0';
+    arrput(dw->outsideStrings, copy);
+    return copy;
+}
+
 static const char* readStringPtr(BinaryReader* reader, DataWin* dw) {
     uint32_t offset = BinaryReader_readUint32(reader);
     if (offset == 0) return nullptr;
-    return (const char*) (dw->strgBuffer + (offset - dw->strgBufferBase));
+    if (offset >= dw->strgBufferBase && offset - dw->strgBufferBase < dw->strgBufferSize) {
+        return (const char*) (dw->strgBuffer + (offset - dw->strgBufferBase));
+    }
+    return readStringOutsideStrg(reader, dw, offset);
 }
 
