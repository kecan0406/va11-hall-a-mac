+static bool fullscreenState = false;
+
+static bool platformGetFullscreen(void) {
+    return fullscreenState;
+}
+
+static void platformSetFullscreen(bool enable) {
+    if (enable == fullscreenState) return;
+    fullscreenState = enable;
+    [window toggleFullScreen:nil];
+}
+
+static void appkitObserveFullscreen(void) {
+    NSNotificationCenter *center = [NSNotificationCenter defaultCenter];
+    [center addObserverForName:NSWindowWillEnterFullScreenNotification object:window queue:nil
+                    usingBlock:^(NSNotification *note) { fullscreenState = true; }];
+    [center addObserverForName:NSWindowWillExitFullScreenNotification object:window queue:nil
+                    usingBlock:^(NSNotification *note) { fullscreenState = false; }];
+}
+
