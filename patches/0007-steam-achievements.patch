+static RValue builtin_steam_get_achievement(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("steam_get_achievement", 1, RValue_makeBool(false));
+    char* name = RValue_toString(args[0], ctx->runner->dataWin);
+    bool achieved = Steamworks_getAchievement(name);
+    free(name);
+    return RValue_makeBool(achieved);
+}
+
+static RValue builtin_steam_set_achievement(VMContext* ctx, RValue* args, int32_t argCount) {
+    REQUIRE_ARGC_AT_LEAST("steam_set_achievement", 1, RValue_makeUndefined());
+    char* name = RValue_toString(args[0], ctx->runner->dataWin);
+    Steamworks_setAchievement(name);
+    free(name);
+    return RValue_makeUndefined();
+}
