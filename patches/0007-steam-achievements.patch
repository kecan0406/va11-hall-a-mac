diff --git a/src/steamworks.c b/src/steamworks.c
new file mode 100644
index 0000000..1e8f37b
--- /dev/null
+++ b/src/steamworks.c
@@ -0,0 +1,86 @@
+#include "steamworks.h"
+#include "common.h"
+#include "log.h"
+
+#ifdef __APPLE__
+#include <dlfcn.h>
+#include <stdint.h>
+
+// Valve's flat C API, as declared in steam_api_flat.h of the Steamworks SDK. The library is opened at run time, so the
+// runner neither links against it nor needs it to start.
+static struct {
+    void* userStats;
+    void (*runCallbacks)(void);
+    void (*shutdown)(void);
+    bool (*getAchievement)(void* userStats, const char* name, bool* achieved);
+    bool (*setAchievement)(void* userStats, const char* name);
+    bool (*storeStats)(void* userStats);
+} steam;
+
+void Steamworks_init(void) {
+    if (steam.userStats != nullptr) return;
+
+    void* library = dlopen("@executable_path/libsteam_api.dylib", RTLD_NOW | RTLD_LOCAL);
+    if (library == nullptr) {
+        logInfo("Steam: no libsteam_api.dylib next to the runner, achievements are off\n");
+        return;
+    }
+
+    int32_t (*initFlat)(char* errorMessage) = dlsym(library, "SteamAPI_InitFlat");
+    void* (*getUserStats)(void) = dlsym(library, "SteamAPI_SteamUserStats_v013");
+    steam.runCallbacks = dlsym(library, "SteamAPI_RunCallbacks");
+    steam.shutdown = dlsym(library, "SteamAPI_Shutdown");
+    steam.getAchievement = dlsym(library, "SteamAPI_ISteamUserStats_GetAchievement");
+    steam.setAchievement = dlsym(library, "SteamAPI_ISteamUserStats_SetAchievement");
+    steam.storeStats = dlsym(library, "SteamAPI_ISteamUserStats_StoreStats");
+    if (initFlat == nullptr || getUserStats == nullptr || steam.runCallbacks == nullptr || steam.shutdown == nullptr ||
+        steam.getAchievement == nullptr || steam.setAchievement == nullptr || steam.storeStats == nullptr) {
+        logInfo("Steam: this libsteam_api.dylib lacks a function the runner uses, achievements are off\n");
+        return;
+    }
+
+    // Steam reads the app ID from the SteamAppId environment variable, which the launcher sets.
+    char message[1024] = {0};
+    if (initFlat(message) != 0) {
+        logInfo("Steam: not connected (%s), achievements are off\n", message);
+        return;
+    }
+    steam.userStats = getUserStats();
+    if (steam.userStats == nullptr) {
+        logInfo("Steam: connected without achievements\n");
+        steam.shutdown();
+        return;
+    }
+    logInfo("Steam: connected, achievements are on\n");
+}
+
+void Steamworks_runCallbacks(void) {
+    if (steam.userStats != nullptr) steam.runCallbacks();
+}
+
+void Steamworks_shutdown(void) {
+    if (steam.userStats == nullptr) return;
+    steam.shutdown();
+    steam.userStats = nullptr;
+}
+
+bool Steamworks_getAchievement(const char* name) {
+    bool achieved = false;
+    return steam.userStats != nullptr && steam.getAchievement(steam.userStats, name, &achieved) && achieved;
+}
+
+// StoreStats is what sends the unlock to Steam; until then it only exists in this process.
+void Steamworks_setAchievement(const char* name) {
+    if (steam.userStats == nullptr || !steam.setAchievement(steam.userStats, name) || !steam.storeStats(steam.userStats)) return;
+    logInfo("Steam: achievement %s unlocked\n", name);
+}
+
+#else
+
+void Steamworks_init(void) {}
+void Steamworks_runCallbacks(void) {}
+void Steamworks_shutdown(void) {}
+bool Steamworks_getAchievement(MAYBE_UNUSED const char* name) { return false; }
+void Steamworks_setAchievement(MAYBE_UNUSED const char* name) {}
+
+#endif
diff --git a/src/steamworks.h b/src/steamworks.h
new file mode 100644
index 0000000..9a10216
--- /dev/null
+++ b/src/steamworks.h
@@ -0,0 +1,15 @@
+#ifndef _BS_STEAMWORKS_H_
+#define _BS_STEAMWORKS_H_
+
+#include <stdbool.h>
+
+// Steam achievements through the libsteam_api.dylib next to the runner. Without that file, or without Steam running,
+// every call does nothing and the game plays the same.
+void Steamworks_init(void);
+void Steamworks_runCallbacks(void);
+void Steamworks_shutdown(void);
+
+bool Steamworks_getAchievement(const char* name);
+void Steamworks_setAchievement(const char* name);
+
+#endif /* _BS_STEAMWORKS_H_ */
