+++ b/src/backends/appkit_mouse.h
@@ -0,0 +1,13 @@
+#ifndef _BS_APPKIT_MOUSE_H_
+#define _BS_APPKIT_MOUSE_H_
+
+#import <AppKit/AppKit.h>
+
+static inline NSPoint appkitWindowPointToViewPixels(NSView* view, NSPoint windowPoint) {
+    NSPoint pixels = [view convertPointToBacking:[view convertPoint:windowPoint fromView:nil]];
+    NSRect backingBounds = [view convertRectToBacking:[view bounds]];
+    pixels.y = backingBounds.size.height - pixels.y;
+    return pixels;
+}
+
+#endif
