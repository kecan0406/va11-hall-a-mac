+// Draws nothing: what cr_none shows, for games that draw their own cursor sprite instead.
+static NSCursor *invisibleCursor(void) {
+    static NSCursor *cursor = nil;
+    if (cursor == nil) {
+        NSBitmapImageRep *rep = [[NSBitmapImageRep alloc] initWithBitmapDataPlanes:NULL pixelsWide:16 pixelsHigh:16
+            bitsPerSample:8 samplesPerPixel:4 hasAlpha:YES isPlanar:NO colorSpaceName:NSDeviceRGBColorSpace
+            bytesPerRow:0 bitsPerPixel:0];
+        memset([rep bitmapData], 0, (size_t)[rep bytesPerRow] * 16);
+        NSImage *image = [[NSImage alloc] initWithSize:NSMakeSize(16, 16)];
+        [image addRepresentation:rep];
+        cursor = [[NSCursor alloc] initWithImage:image hotSpot:NSZeroPoint];
+        [image release];
+        [rep release];
+    }
+    return cursor;
+}
